# Gujjify website - Hostinger (LiteSpeed/Apache) config for the built React app (upload dist/ to public_html)
Options -MultiViews
RewriteEngine On

# 1) One canonical host: https://www.gujjify.com
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.gujjify.com%{REQUEST_URI} [L,R=301]

# 2) Old PHP site URLs -> new routes (keeps links shared on WhatsApp/Instagram working)
RewriteRule ^index\.php$ / [L,R=301]
RewriteRule ^about\.php$ /about [L,R=301]
RewriteRule ^services\.php$ /services [L,R=301]
RewriteRule ^blog\.php$ /blog [L,R=301]
RewriteRule ^faq\.php$ /faq [L,R=301]
RewriteRule ^contact\.php$ /contact [L,R=301]
RewriteCond %{QUERY_STRING} (?:^|&)slug=([^&]+)
RewriteRule ^blog-post\.php$ /blog/%1? [L,R=301]

# 3) Single-page-app fallback: serve index.html for app routes (real files/folders are served as-is)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# 4) Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always unset X-Powered-By
</IfModule>

# 5) Caching: hashed build assets forever, HTML never
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
